// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Supabase PostgreSQL for production
  // Use DATABASE_URL (Transaction pooler) for normal queries
  // Use DIRECT_URL (Direct connection) for migrations
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Prediction {
  id             Int        @id @default(autoincrement())
  imageUrl       String
  itemType       String
  condition      String
  confidence     Float
  hazard         Boolean    @default(false)
  reuseScore     Float      @default(0)
  action         String
  recommendation String
  createdAt      DateTime   @default(now())
  feedbacks      Feedback[]
}

model Feedback {
  id           Int        @id @default(autoincrement())
  predictionId Int
  aiAction     String
  humanAction  String
  createdAt    DateTime   @default(now())
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
}
